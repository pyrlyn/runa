# Build artifacts (never commit; Cargo.lock IS committed — binaries + D16 pins).
/target
.DS_Store

# moon generated cache (keep .moon/workspace.yml, toolchains.yml, tasks/).
.moon/cache/
.moon/docker/

# cargo-dist packaged apps (P6.3).
/dist/

# LMDB prompt-cache / test DBs if they land in-tree.
*.mdb

# Python fixture scripts.
__pycache__/
*.pyc

# Real GGUF weights: tracked via Git LFS (see .gitattributes). Header-only
# synthetics stay as normal git blobs; large weights use LFS. Until the LFS
# objects are committed, keep local downloads untracked with:
#   git status --ignored
# To add a new weight: ensure the *.gguf LFS pattern matches, then git add -f.
# (Previously ignored entirely because GitHub rejects >100MB blobs.)
# tests/fixtures/*.gguf
# !tests/fixtures/synthetic-*.gguf

# Docs site dependencies.
site/node_modules/
