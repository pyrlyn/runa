{
  "$description": "runa brand (local fire: a geometric rune stave with an ember at its base, on warm charcoal). Local deltas only; extends @pyrlyn/brand base/tokens.json (pinned in package.json), built by `node build.mjs` into dist/tokens.css. Source: pyrlyn/runa@947399f docs/brand/DESIGN.md and docs/brand/tokens.css. Roles map the runa names: bg-elevated→surface, surface-1→surface-2, surface-2→surface-3, accent-soft→accent-muted, shadow→shadow-e1. Keys that are not base roles become --runa-*. Status fills come from docs/brand/tokens.css; the light *-fg text variants and accent-fg are derived (same hue, darkened to WCAG AA) because docs/brand has no text variants; all are checked in README.md.",
  "$extends": "@pyrlyn/brand/base/tokens.json",
  "$extensions": {
    "com.pyrlyn.brand": "runa",
    "com.pyrlyn.defaultTheme": "light"
  },
  "brand": {
    "$description": "Brand constants, identical in both themes.",
    "charcoal": {
      "$type": "color",
      "$value": "#1C1412",
      "$description": "logo tile, code ground"
    },
    "ember": {
      "$type": "color",
      "$value": "#E85A3C",
      "$description": "rune arms; light accent, dark accent-muted"
    },
    "ember-glow": {
      "$type": "color",
      "$value": "#FFB088",
      "$description": "ember core; CLI highlight"
    },
    "ember-deep": {
      "$type": "color",
      "$value": "#C94830",
      "$description": "light accent hover"
    }
  },
  "theme": {
    "$description": "Per theme. Light is the default (docs/brand/tokens.css :root).",
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#F8F3F0",
        "$description": "page ground, warm ash (docs/brand: bg)"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "cards (bg-elevated)"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#F0E8E3",
        "$description": "nested panels, chips (surface-1)"
      },
      "surface-3": {
        "$type": "color",
        "$value": "#E6D9D1",
        "$description": "hover (surface-2)"
      },
      "border": {
        "$type": "color",
        "$value": "#C4B0A4",
        "$description": "default border"
      },
      "fg": {
        "$type": "color",
        "$value": "#1C1412",
        "$description": "primary text"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "#5A4A44",
        "$description": "secondary text"
      },
      "fg-subtle": {
        "$type": "color",
        "$value": "#8A7870",
        "$description": "tertiary text; 3.47:1, below AA (see README)"
      },
      "accent": {
        "$type": "color",
        "$value": "{brand.ember}",
        "$description": "primary CTA, ember; a fill, 2.91:1 as text on light (use accent-fg)"
      },
      "accent-muted": {
        "$type": "color",
        "$value": "#FCE8E0",
        "$description": "soft accent wash (accent-soft)"
      },
      "accent-fg": {
        "$type": "color",
        "$value": "#B6412C",
        "$description": "accent as text on light; derived: accent-hover #C94830 darkened until >= 4.5:1 on bg, surface and surface-2"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{brand.charcoal}",
        "$description": "text on the ember fill: 5.15:1 (white would be 3.52:1)"
      },
      "success": {
        "$type": "color",
        "$value": "#3D7A4A",
        "$description": "status fill (docs/brand: success)"
      },
      "success-fg": {
        "$type": "color",
        "$value": "#3A7547",
        "$description": "status text; derived from success, darkened until >= 4.5:1"
      },
      "warn": {
        "$type": "color",
        "$value": "#D4893A",
        "$description": "status fill (docs/brand: warning); 2.33:1 on bg, so pair it with warn-fg text or an outline"
      },
      "warn-fg": {
        "$type": "color",
        "$value": "#945C20",
        "$description": "status text; derived from warning, darkened until >= 4.5:1"
      },
      "danger": {
        "$type": "color",
        "$value": "#C9302C",
        "$description": "status fill (docs/brand: danger)"
      },
      "danger-fg": {
        "$type": "color",
        "$value": "#C52F2B",
        "$description": "status text; derived from danger, darkened until >= 4.5:1"
      },
      "mark-tile": {
        "$type": "color",
        "$value": "{brand.charcoal}",
        "$description": "logo tile, always warm charcoal"
      },
      "shadow-e1": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(28, 20, 18, 0.06), 0 4px 12px rgba(28, 20, 18, 0.04)",
        "$description": "docs/brand: shadow"
      },
      "accent-hover": {
        "$type": "color",
        "$value": "{brand.ember-deep}",
        "$description": "hover on the ember fill"
      },
      "ember": {
        "$type": "color",
        "$value": "#FF9A6A",
        "$description": "highlight, local fire"
      },
      "info": {
        "$type": "color",
        "$value": "#5A6B8A",
        "$description": "info status"
      },
      "surface-pressed": {
        "$type": "color",
        "$value": "#D8C8BE",
        "$description": "pressed (surface-3)"
      },
      "border-hairline": {
        "$type": "color",
        "$value": "#E0D4CC",
        "$description": "divider"
      },
      "code-bg": {
        "$type": "color",
        "$value": "#1C1412",
        "$description": "code and CLI blocks, dark in both themes"
      },
      "code-fg": {
        "$type": "color",
        "$value": "{brand.ember-glow}",
        "$description": "CLI highlight"
      },
      "glass-fill": {
        "$type": "string",
        "$value": "rgba(255, 255, 255, 0.72)",
        "$description": "glass panels"
      },
      "glass-border": {
        "$type": "string",
        "$value": "rgba(224, 212, 204, 0.9)",
        "$description": "glass panel border"
      },
      "accent-glow": {
        "$type": "shadow",
        "$value": "0 0 0 3px var(--pyr-accent-muted), 0 0 18px rgba(232, 90, 60, 0.22)",
        "$description": "soft focus/agent glow"
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "#120E0C",
        "$description": "page ground"
      },
      "surface": {
        "$type": "color",
        "$value": "#1C1412",
        "$description": "cards (bg-elevated)"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#261E1A",
        "$description": "nested panels, chips (surface-1)"
      },
      "surface-3": {
        "$type": "color",
        "$value": "#322824",
        "$description": "hover (surface-2)"
      },
      "border": {
        "$type": "color",
        "$value": "#4E403A",
        "$description": "default border"
      },
      "fg": {
        "$type": "color",
        "$value": "#F0E8E3",
        "$description": "primary text"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "#B0A098",
        "$description": "secondary text"
      },
      "fg-subtle": {
        "$type": "color",
        "$value": "#786860",
        "$description": "tertiary text; 3.08:1, below AA (see README)"
      },
      "accent": {
        "$type": "color",
        "$value": "#F07050",
        "$description": "primary CTA"
      },
      "accent-muted": {
        "$type": "color",
        "$value": "#2A1814",
        "$description": "soft accent wash (accent-soft)"
      },
      "accent-fg": {
        "$type": "color",
        "$value": "#F07050",
        "$description": "accent as text: the accent itself, 5.56:1 (set so the light value does not cascade into dark)"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#120E0C",
        "$description": "text on the accent fill: 6.53:1"
      },
      "success": {
        "$type": "color",
        "$value": "#6BBF7A",
        "$description": "status (docs/brand: success)"
      },
      "success-fg": {
        "$type": "color",
        "$value": "#6BBF7A",
        "$description": ">= 7.29:1"
      },
      "warn": {
        "$type": "color",
        "$value": "#E8A05C",
        "$description": "status (docs/brand: warning)"
      },
      "warn-fg": {
        "$type": "color",
        "$value": "#E8A05C",
        "$description": ">= 7.49:1"
      },
      "danger": {
        "$type": "color",
        "$value": "#F07068",
        "$description": "status (docs/brand: danger)"
      },
      "danger-fg": {
        "$type": "color",
        "$value": "#F07068",
        "$description": ">= 5.63:1"
      },
      "mark-tile": {
        "$type": "color",
        "$value": "{brand.charcoal}",
        "$description": "logo tile, always warm charcoal"
      },
      "shadow-e1": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 16px rgba(0, 0, 0, 0.28)",
        "$description": "docs/brand: shadow"
      },
      "accent-hover": {
        "$type": "color",
        "$value": "#FF9A6A",
        "$description": "hover on the accent fill"
      },
      "ember": {
        "$type": "color",
        "$value": "{brand.ember-glow}",
        "$description": "highlight, local fire"
      },
      "info": {
        "$type": "color",
        "$value": "#8A9BB8",
        "$description": "info status"
      },
      "surface-pressed": {
        "$type": "color",
        "$value": "#403430",
        "$description": "pressed (surface-3)"
      },
      "border-hairline": {
        "$type": "color",
        "$value": "#2A221E",
        "$description": "divider"
      },
      "code-bg": {
        "$type": "color",
        "$value": "#0C0908",
        "$description": "code and CLI blocks"
      },
      "code-fg": {
        "$type": "color",
        "$value": "{brand.ember-glow}",
        "$description": "prompt and tokens"
      },
      "glass-fill": {
        "$type": "string",
        "$value": "rgba(28, 20, 18, 0.72)",
        "$description": "glass panels"
      },
      "glass-border": {
        "$type": "string",
        "$value": "rgba(42, 34, 30, 0.9)",
        "$description": "glass panel border"
      },
      "accent-glow": {
        "$type": "shadow",
        "$value": "0 0 0 3px var(--pyr-accent-muted), 0 0 20px rgba(240, 112, 80, 0.28)",
        "$description": "soft focus/agent glow"
      }
    }
  }
}
